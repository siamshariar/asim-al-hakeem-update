# Copy to .env.local for local development, and set the same variables in the hosting
# dashboard (Vercel: Project → Settings → Environment Variables) for production.

# --- Website forms (Contact, Ask a Question, Counselling) → pages/api/sendMail.js ---
# Where submissions go is decided in code:
#   live site (Vercel "Production")            → sheikhassim.bookings@gmail.com
#   everywhere else (local, previews, tests)   → siam.it.int@gmail.com  (subject starts with "[Test]")
# Each message is sent from that same Gmail account, so the only required setting is that account's
# Gmail App Password (Google Account → Security → 2-Step Verification → App passwords). Never commit it.
#   Vercel Production: the App Password of sheikhassim.bookings@gmail.com
#   .env.local / Vercel Preview: the App Password of siam.it.int@gmail.com
AUTH_EMAIL_PASSWORD=

# Optional overrides — leave empty. Setting CONTACT_EMAIL for every environment would send test
# messages to that address too. (Defaults: the inbox above, smtp.gmail.com, port 465)
AUTH_EMAIL=
CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=

# Alternative to Gmail: SendGrid (an API key starting with "SG."; the sender must be verified there)
SENDGRID_API_KEY=

# --- Google Analytics measurement ID (G-...) ---
NEXT_PUBLIC_GA_ID=
